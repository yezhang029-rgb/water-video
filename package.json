  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/media": "4.0.534",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
