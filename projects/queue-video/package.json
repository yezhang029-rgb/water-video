{
  "name": "queue-video", "version": "0.1.0", "private": true, "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-project.mjs && tsc --noEmit",
    "render:review": "remotion render src/index.ts QueueFilm out/queue-A-v02-review.mp4 --scale=0.5 --codec=h264 --crf=24 --browser-executable=/usr/bin/chromium --concurrency=4",
    "render:final": "remotion render src/index.ts QueueFilm out/queue-A-v02-1080p.mp4 --codec=h264 --crf=19 --browser-executable=/usr/bin/chromium --concurrency=4"
  },
  "dependencies": {"@remotion/cli":"4.0.534", "@remotion/media":"4.0.534", "react":"19.2.4", "react-dom":"19.2.4", "remotion":"4.0.534"},
  "devDependencies": {"@types/react":"19.2.14", "@types/react-dom":"19.2.3", "typescript":"5.9.3"}
}
